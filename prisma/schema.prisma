generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id         String     @id @default(cuid())
  name       String
  createdAt  DateTime   @default(now())

  apiKeys    ApiKey[]
  identities Identity[]
}

model ApiKey {
  id         String   @id @default(cuid())
  key        String   @unique
  createdAt  DateTime @default(now())

  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}

model Identity {
  id            String   @id @default(cuid())

  fingerprint   String

  identityType  String

  trustScore    Int      @default(50)

  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

sessions      Session[]
events        Event[]
memories      Memory[]
outcomes      Outcome[]
assessments   TrustAssessment[]
}

model Session {
  id            String   @id

  createdAt     DateTime @default(now())

  identityId    String
  identity            Identity @relation(fields: [identityId], references: [id])
  events        Event[]
  outcomes      Outcome[]
}
model Memory {
  id            String   @id @default(cuid())

  memoryType    String

  confidence    Float

  createdAt     DateTime @default(now())

  identityId    String
  identity      Identity @relation(fields: [identityId], references: [id])
}

// What was concluded about an event, kept off the event itself.
//
// riskScore and decision lived on Event until they were moved here. Both inputs
// the score reads — path and userAgent — stay on the observation, so a verdict
// plus its event is enough to recompute it, provided the reasons and the version
// of the rule are recorded too. reasons and methodVersion are nullable only
// because the 46 rows moved out of Event never had either.
model EventAssessment {
  id            String   @id @default(cuid())

  eventId       String
  event         Event    @relation(fields: [eventId], references: [id])

  riskScore     Int

  decision      String

  reasons       String?

  methodVersion String?

  createdAt     DateTime @default(now())

  @@index([eventId])
}

model Outcome {
  id            String   @id @default(cuid())

  outcomeType   String

  source        String

  confidence    Float    @default(1.0)

  createdAt     DateTime @default(now())
  
  correlationId String?    

  identityId    String?
  identity      Identity? @relation(fields: [identityId], references: [id])

  sessionId     String?
  session       Session? @relation(fields: [sessionId], references: [id])
}


model TrustAssessment {
  id                  String   @id @default(cuid())

  trustScore          Int

  confidence          Float

  intent              String

  signals             String?

  evidence            String?

  // What the assessment needs in order to be recomputed: the version of the
  // method that produced it, and the observation count that method consumed.
  // Without these a replay applies today's model to yesterday's row.
  modelVersions       String?

  observedEventCount  Int?

  assessmentTimestamp DateTime

  identityId          String
  identity            Identity @relation(fields: [identityId], references: [id])
}

model Event {
  id            String   @id @default(cuid())

  eventType     String

  path          String?

  ip            String?

  userAgent     String?

  referrer     String?

  sessionId    String?

  session      Session? @relation( fields: [sessionId],references: [id])

  createdAt     DateTime @default(now())

  identityId    String

    mouseMoves        Int?

  scrollDepth       Int?

  clickCount        Int?

  focusEvents       Int?

  readingTime       Int?

  deviceFingerprint String?

  challengeResult   String?

  identity      Identity @relation(fields: [identityId], references: [id])

  // What was concluded about this event, in its own rows. Nothing on this model
  // is a judgement; that separation is the Reality Boundary.
  assessments   EventAssessment[]
}
